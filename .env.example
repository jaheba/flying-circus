# Copy to .env and set the absolute path to the Monty worker binary.
MONTY_BIN=/absolute/path/to/monty
MONTY_REVISION=unverified-local
MONTY_BUILD_INFO="Source revision and compiler flags unverified"
CPYTHON_BIN=python3
# auto detects pypy3 on PATH; an empty value disables PyPy.
PYPY_BIN=auto
SAMPLES=20
MEMORY_SAMPLES=3
TIMEOUT=30
# Set to 1 for older Monty CLIs that print a timing summary to stdout.
LEGACY_CLI_SUMMARY=0
